# Frontend environment (Vite). Only VITE_* variables are exposed to the browser — never put secrets here.

# Leave empty to call the API on the same origin (/api, proxied by Vercel or the Vite dev server).
# Set to an absolute URL only if the API is on its own subdomain (requires CORS + SESSION_COOKIE_DOMAIN on the API).
VITE_API_BASE_URL=

# Where "Sign in with TMP" sends people. TMP must redirect back to
#   https://graphing.themodernpedagogues.com/auth/callback?handoff=<short-lived token>
# See docs/AUTH_INTEGRATION.md.
VITE_TMP_SIGNIN_URL=https://themodernpedagogues-70f4f230adc2.herokuapp.com/login

# "Back to TMP" link in the header
VITE_TMP_HOME_URL=https://themodernpedagogues-70f4f230adc2.herokuapp.com
