# Copy to .env for local work (never commit .env). On Render, set these in the dashboard / render.yaml.

NODE_ENV=development
PORT=8787

# Browser origins allowed to call the API (comma separated). Production: https://graphing.themodernpedagogues.com
FRONTEND_ORIGINS=http://localhost:5173

# Our own session cookie signing secret. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change-me-change-me-change-me-change-me
SESSION_TTL_SECONDS=28800
# Only if the API lives on a sibling subdomain instead of behind the Vercel /api rewrite:
# SESSION_COOKIE_DOMAIN=.themodernpedagogues.com

# ---- TMP account integration (see docs/AUTH_INTEGRATION.md) ----
# jwt-hs256 | jwt-rs256 | introspect
TMP_AUTH_MODE=jwt-hs256
TMP_HANDOFF_SECRET=change-me-change-me-change-me-change-me
# jwt-rs256 only (use \n for newlines):
# TMP_HANDOFF_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----
# introspect only:
# TMP_INTROSPECT_URL=https://themodernpedagogues-70f4f230adc2.herokuapp.com/api/auth/verify
TMP_TOKEN_ISSUER=themodernpedagogues.com
TMP_TOKEN_AUDIENCE=tmp-graphing-studio
TMP_HANDOFF_MAX_AGE_SECONDS=300
# Map TMP role names to Studio roles (admin|tutor|student|viewer). Unknown roles become "viewer".
# TMP_ROLE_MAP={"teacher":"tutor","pupil":"student"}

# ---- Storage ----
# Production: a Postgres connection string (Render provides DATABASE_URL). Empty = JSON file store (dev only).
DATABASE_URL=
DATA_FILE=./data/boards.json
# TRUST_PROXY_HOPS=2   # proxies in front of the API (default 2 in production)
MAX_BOARD_BYTES=1500000

# Development only — enables POST /api/dev/login so you can test tutor/student flows without TMP.
DEV_AUTH=true
